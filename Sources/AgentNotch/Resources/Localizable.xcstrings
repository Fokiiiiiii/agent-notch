    "settings.animationSpeedHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scales how long spring/fade animations take. Lower is faster."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整弹簧/淡入淡出动画的时长，数值越低速度越快。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la duración de las animaciones de resorte/desvanecimiento. Menor es más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la durée des animations de ressort/fondu. Plus bas est plus rapide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert die Dauer von Feder-/Überblendanimationen. Niedriger ist schneller."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяет длительность пружинных анимаций/затухания. Меньше — быстрее."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط مدة حركات الانتقال. القيمة الأقل أسرع."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta a duração das animações de mola/esmaecimento. Menor é mais rápido."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्प्रिंग/फेड एनिमेशन की अवधि को समायोजित करता है। कम मान तेज़ होता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スプリング/フェードアニメーションの長さを調整します。値が小さいほど速くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스프링/페이드 애니메이션의 길이를 조절합니다. 값이 낮을수록 빠릅니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la durata delle animazioni a molla/dissolvenza. Più basso è più veloce."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur lama animasi spring/fade. Semakin rendah semakin cepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh thời gian hoạt ảnh spring/fade. Giá trị thấp hơn thì nhanh hơn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับระยะเวลาของแอนิเมชันสปริง/เฟด ค่ายิ่งต่ำยิ่งเร็ว"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinasaayos ang tagal ng spring/fade animation. Mas mababa, mas mabilis."
          }
        }
      }
    },
