    "settings.noShortcutsFound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shortcuts found. Create one in the Shortcuts app, then reopen this window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到快捷指令。请先在“快捷指令”App 中创建，然后重新打开此窗口。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron atajos. Crea uno en la app Atajos y vuelve a abrir esta ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun raccourci trouvé. Créez-en un dans l'app Raccourcis, puis rouvrez cette fenêtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kurzbefehle gefunden. Erstelle einen in der Kurzbefehle-App und öffne dieses Fenster erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрые команды не найдены. Создайте команду в приложении «Быстрые команды» и снова откройте это окно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على اختصارات. أنشئ اختصارًا في تطبيق الاختصارات ثم أعد فتح هذه النافذة."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum atalho encontrado. Crie um no app Atalhos e reabra esta janela."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई शॉर्टकट नहीं मिला। Shortcuts ऐप में एक बनाएँ, फिर यह विंडो दोबारा खोलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットが見つかりません。ショートカット App で作成してから、このウインドウを開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어를 찾을 수 없습니다. 단축어 앱에서 만든 다음 이 창을 다시 여세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun comando rapido trovato. Creane uno nell'app Comandi rapidi e riapri questa finestra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pintasan. Buat satu di app Pintasan, lalu buka lagi jendela ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy phím tắt. Hãy tạo một cái trong ứng dụng Phím tắt rồi mở lại cửa sổ này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบทางลัด สร้างในแอปทางลัดก่อน แล้วเปิดหน้าต่างนี้ใหม่"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang natagpuang shortcut. Gumawa ng isa sa Shortcuts app, tapos buksan ulit ang window na ito."
          }
        }
      }
    },
    "settings.notificationsPurpose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets AgentNotch alert you when the notch itself isn't visible (for example, in full screen)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海不可见时（例如全屏状态）让 AgentNotch 提醒你。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que AgentNotch te avise cuando la muesca no está visible (por ejemplo, en pantalla completa)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à AgentNotch de vous avertir quand l'encoche n'est pas visible (en plein écran, par exemple)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht AgentNotch, dich zu benachrichtigen, wenn die Notch nicht sichtbar ist (etwa im Vollbild)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет AgentNotch уведомлять вас, когда панель не видна (например, в полноэкранном режиме)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لـ AgentNotch تنبيهك عندما لا يكون النوتش مرئيًا (في وضع ملء الشاشة مثلًا)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o AgentNotch avise você quando o notch não estiver visível (por exemplo, em tela cheia)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब नॉच दिखाई न दे (जैसे फ़ुल स्क्रीन में) तब AgentNotch को सूचित करने देता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチが見えていないとき（フルスクリーン中など）に AgentNotch から通知できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치가 보이지 않을 때(예: 전체 화면) AgentNotch가 알릴 수 있게 합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente ad AgentNotch di avvisarti quando il notch non è visibile (ad esempio a schermo intero)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan AgentNotch memberi tahu Anda saat notch tidak terlihat (misalnya saat layar penuh)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép AgentNotch thông báo khi notch không hiển thị (ví dụ khi toàn màn hình)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ AgentNotch แจ้งเตือนคุณเมื่อมองไม่เห็นโน้ตช์ (เช่น ตอนเต็มหน้าจอ)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinahayaan ang AgentNotch na mag-alerto kapag hindi nakikita ang notch (halimbawa, sa full screen)."
          }
        }
      }
    },
