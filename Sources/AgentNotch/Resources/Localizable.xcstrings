    "settings.airPodsStatusHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the connected headphones' battery level next to the Mac's own, in the panel's top bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在面板顶栏中，把已连接耳机的电量显示在 Mac 电量旁边。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el nivel de batería de los auriculares conectados junto al del Mac, en la barra superior del panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute le niveau de batterie du casque connecté à côté de celui du Mac, dans la barre supérieure du panneau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Batteriestand der verbundenen Kopfhörer neben dem des Macs in der oberen Leiste des Panels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет заряд подключённых наушников рядом с зарядом Mac в верхней панели."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف مستوى بطارية السماعات المتصلة بجانب بطارية الـ Mac في الشريط العلوي للوحة."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona o nível de bateria dos fones conectados ao lado do nível do Mac, na barra superior do painel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैनल की ऊपरी पट्टी में, जुड़े हेडफ़ोन की बैटरी Mac की बैटरी के बगल में दिखाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネル上部のバーに、接続中のヘッドフォンのバッテリー残量を Mac の残量の隣に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널 상단 막대에 연결된 헤드폰의 배터리 잔량을 Mac 잔량 옆에 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge il livello di batteria delle cuffie collegate accanto a quello del Mac, nella barra superiore del pannello."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan level baterai headphone yang terhubung di samping milik Mac, pada bilah atas panel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm mức pin của tai nghe đang kết nối cạnh mức pin của Mac, ở thanh trên của bảng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มระดับแบตเตอรี่ของหูฟังที่เชื่อมต่อไว้ข้างของ Mac ในแถบด้านบนของแผง"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Idinaragdag ang antas ng baterya ng nakakonektang headphone katabi ng sa Mac, sa itaas na bar ng panel."
          }
        }
      }
    },
