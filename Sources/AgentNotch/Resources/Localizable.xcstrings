    "settings.notificationsDenied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. AgentNotch can't alert you when the notch itself isn't visible (e.g. while in full screen)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。当灵动岛本身不可见时（例如全屏时），AgentNotch 将无法提醒你。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. AgentNotch no puede avisarte cuando la muesca no es visible (por ejemplo, en pantalla completa)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. AgentNotch ne peut pas vous alerter lorsque l'encoche elle-même n'est pas visible (par exemple en plein écran)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind deaktiviert. AgentNotch kann dich nicht benachrichtigen, wenn der Notch selbst nicht sichtbar ist (z. B. im Vollbildmodus)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены. AgentNotch не сможет предупредить вас, если сама панель не видна (например, в полноэкранном режиме)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات متوقفة. لا يمكن لـ AgentNotch تنبيهك عندما لا يكون الشق نفسه مرئيًا (مثل وضع ملء الشاشة)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. O AgentNotch não pode avisá-lo quando o notch não estiver visível (por exemplo, em tela cheia)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएं बंद हैं। जब नॉच स्वयं दिखाई नहीं देता (जैसे फ़ुल स्क्रीन में), तो AgentNotch आपको सचेत नहीं कर सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフになっています。ノッチ自体が表示されていない場合（フルスクリーン時など）、AgentNotchは通知できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있습니다. 노치 자체가 보이지 않을 때(예: 전체 화면 사용 중) AgentNotch가 알려드릴 수 없습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate. AgentNotch non può avvisarti quando il notch stesso non è visibile (ad es. a schermo intero)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi mati. AgentNotch tidak dapat memberi tahu Anda saat notch itu sendiri tidak terlihat (misalnya saat layar penuh)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đang tắt. AgentNotch không thể cảnh báo bạn khi notch không hiển thị (ví dụ: khi ở chế độ toàn màn hình)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนปิดอยู่ AgentNotch ไม่สามารถแจ้งเตือนคุณได้เมื่อรอยบากเองไม่ปรากฏให้เห็น (เช่น ขณะอยู่ในโหมดเต็มหน้าจอ)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang mga notification. Hindi maaabisuhan ka ng AgentNotch kapag hindi nakikita ang notch mismo (hal. habang naka-full screen)."
          }
        }
      }
    },
