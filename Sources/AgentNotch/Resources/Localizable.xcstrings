    "settings.remindersPurpose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows reminders due today in the Dashboard's calendar widget, alongside your events."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在仪表板的日历小组件中，与日程一起显示今天到期的提醒事项。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los recordatorios que vencen hoy en el widget de calendario del panel, junto a tus eventos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les rappels dus aujourd'hui dans le widget calendrier du tableau de bord, à côté de vos événements."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt heute fällige Erinnerungen im Kalender-Widget des Dashboards neben deinen Terminen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает напоминания на сегодня в виджете календаря рядом с событиями."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض التذكيرات المستحقة اليوم في عنصر التقويم بلوحة المعلومات إلى جانب أحداثك."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os lembretes que vencem hoje no widget de calendário do painel, junto aos seus eventos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डैशबोर्ड के कैलेंडर विजेट में आज देय रिमाइंडर आपके इवेंट्स के साथ दिखाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダッシュボードのカレンダーウィジェットに、予定と並べて今日期限のリマインダーを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대시보드의 캘린더 위젯에 오늘 마감인 미리 알림을 일정과 함께 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i promemoria in scadenza oggi nel widget calendario della dashboard, accanto ai tuoi eventi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan pengingat yang jatuh tempo hari ini di widget kalender dasbor, bersama acara Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị lời nhắc đến hạn hôm nay trong widget lịch của bảng điều khiển, cạnh các sự kiện."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงการเตือนที่ครบกำหนดวันนี้ในวิดเจ็ตปฏิทินของแดชบอร์ด ควบคู่กับกิจกรรมของคุณ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ang mga paalalang due ngayong araw sa calendar widget ng dashboard, katabi ng iyong mga event."
          }
        }
      }
    },
