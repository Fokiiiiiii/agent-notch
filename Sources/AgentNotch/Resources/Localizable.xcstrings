    "settings.soundEffectsHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a short tone for approvals, questions, and other notch events."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在批准、提问及其他灵动岛事件发生时播放简短提示音。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce un tono breve para aprobaciones, preguntas y otros eventos de la muesca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue un court son pour les approbations, questions et autres événements de l'encoche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt einen kurzen Ton bei Genehmigungen, Fragen und anderen Notch-Ereignissen ab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводит короткий звук при подтверждениях, вопросах и других событиях панели."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل نغمة قصيرة عند الموافقات والأسئلة وأحداث الشق الأخرى."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz um som curto para aprovações, perguntas e outros eventos do notch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वीकृतियों, प्रश्नों और अन्य नॉच घटनाओं के लिए एक छोटी ध्वनि बजाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認・質問・その他のノッチイベント時に短い音を再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인, 질문 및 기타 노치 이벤트에 짧은 알림음을 재생합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce un breve suono per approvazioni, domande e altri eventi del notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memutar nada singkat untuk persetujuan, pertanyaan, dan peristiwa notch lainnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát âm thanh ngắn cho các phê duyệt, câu hỏi và sự kiện notch khác."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นเสียงสั้นๆ สำหรับการอนุมัติ คำถาม และเหตุการณ์รอยบากอื่นๆ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpe-play ng maikling tunog para sa mga pag-apruba, tanong, at iba pang notch event."
          }
        }
      }
    },
