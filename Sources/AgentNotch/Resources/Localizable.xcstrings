          "stringUnit": {
            "state": "translated",
            "value": "नॉच खोलने, बंद करने या छिपाने के लिए ऊपर-नीचे स्वाइप करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦方向にスワイプしてノッチを開く・閉じる・隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래로 쓸어 노치를 열거나 닫거나 숨기기"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su o giù per aprire, chiudere o nascondere il notch"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser ke atas atau bawah untuk membuka, menutup, atau menyembunyikan notch"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt lên hoặc xuống để mở, đóng hoặc ẩn notch"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดขึ้นหรือลงเพื่อเปิด ปิด หรือซ่อนโน้ตช์"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-swipe pataas o pababa para buksan, isara, o itago ang notch"
          }
        }
      }
