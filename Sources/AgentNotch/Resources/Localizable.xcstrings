    "approval.reviewAction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review this action before %@ continues."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Claude 继续之前请检查此操作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa esta acción antes de que Claude continúe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez cette action avant que Claude ne continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe diese Aktion, bevor Claude fortfährt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите это действие, прежде чем Claude продолжит."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع هذا الإجراء قبل أن يواصل Claude."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise esta ação antes que o Claude continue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude के जारी रहने से पहले इस क्रिया की समीक्षा करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude が続行する前にこのアクションを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude가 계속하기 전에 이 작업을 검토하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivedi questa azione prima che Claude continui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjau tindakan ini sebelum Claude melanjutkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại hành động này trước khi Claude tiếp tục."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบการดำเนินการนี้ก่อนที่ Claude จะดำเนินการต่อ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Suriin ang aksyong ito bago magpatuloy ang Claude."
          }
        }
      }
    },
