    "settings.autoOpenOnAttentionHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, an incoming request only shows the compact badge and waits for you to click it — nothing is auto-approved either way."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，收到请求时只显示小徽标并等待你点击——无论如何都不会自动批准。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se desactiva, una solicitud entrante solo muestra la insignia compacta y espera a que hagas clic; en ningún caso se aprueba automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, une demande entrante n'affiche que le badge compact et attend votre clic — rien n'est approuvé automatiquement dans les deux cas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviert zeigt eine eingehende Anfrage nur das kompakte Abzeichen und wartet auf deinen Klick – automatisch freigegeben wird ohnehin nichts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, входящий запрос только покажет компактный значок и будет ждать нажатия — автоматически ничего не подтверждается в любом случае."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف، يعرض الطلب الوارد الشارة المصغّرة فقط وينتظر نقرتك — ولا تتم الموافقة تلقائيًا في الحالتين."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, uma solicitação só mostra o selo compacto e aguarda seu clique — nada é aprovado automaticamente de qualquer forma."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद होने पर, आने वाला अनुरोध सिर्फ़ कॉम्पैक्ट बैज दिखाता है और आपके क्लिक की प्रतीक्षा करता है — किसी भी हाल में कुछ भी स्वतः स्वीकृत नहीं होता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのときは、リクエストが来てもコンパクト表示のバッジを出すだけで、クリックを待ちます。どちらの設定でも自動承認は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 들어온 요청이 축소된 배지만 표시하고 클릭을 기다립니다 — 어느 쪽이든 자동 승인은 하지 않습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, una richiesta in arrivo mostra solo il badge compatto e attende il tuo clic: in nessun caso viene approvata automaticamente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika mati, permintaan yang masuk hanya menampilkan lencana ringkas dan menunggu klik Anda — tidak ada yang disetujui otomatis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, yêu cầu đến chỉ hiện huy hiệu thu gọn và chờ bạn nhấp — dù thế nào cũng không tự động phê duyệt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิด คำขอที่เข้ามาจะแสดงเพียงป้ายแบบย่อและรอให้คุณคลิก — ไม่มีการอนุมัติอัตโนมัติในทั้งสองกรณี"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naka-off, ang papasok na request ay nagpapakita lang ng compact badge at naghihintay ng click mo — walang awtomatikong pag-apruba sa alinmang kaso."
          }
        }
      }
    },
