    "today.focusContinuesDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer continues when you switch views or close the Nook."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使切换视图或关闭 Nook，计时器仍会继续运行。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El temporizador continúa aunque cambies de vista o cierres el Nook."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le minuteur continue même si vous changez de vue ou fermez le Nook."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Timer läuft weiter, auch wenn du die Ansicht wechselst oder den Nook schließt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймер продолжает работать при переключении вида или закрытии Nook."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر المؤقت عند تبديل طرق العرض أو إغلاق Nook."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O temporizador continua mesmo ao trocar de visualização ou fechar o Nook."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दृश्य बदलने या Nook बंद करने पर भी टाइमर जारी रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューを切り替えたり Nook を閉じたりしてもタイマーは継続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보기를 전환하거나 Nook을 닫아도 타이머는 계속됩니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il timer continua anche se cambi vista o chiudi il Nook."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer terus berjalan meskipun Anda beralih tampilan atau menutup Nook."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ hẹn giờ vẫn tiếp tục khi bạn chuyển chế độ xem hoặc đóng Nook."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวจับเวลาจะทำงานต่อไปแม้คุณจะสลับมุมมองหรือปิด Nook"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magpapatuloy ang timer kahit lumipat ka ng view o isara ang Nook."
          }
        }
      }
    },
