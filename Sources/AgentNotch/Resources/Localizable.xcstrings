          "stringUnit": {
            "state": "translated",
            "value": "पैनल के कोनों की त्रिज्या को समायोजित करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルの角の丸みを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널 모서리의 둥글기를 조절합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola il raggio degli angoli del pannello."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur radius sudut panel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh bán kính góc của bảng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับรัศมีมุมของแผง"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinasaayos ang radius ng sulok ng panel."
          }
        }
      }
    },
    "settings.dashboardWidgetsHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets are laid out left to right in this order. The notch panel keeps its width, so the widgets share it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件按此顺序从左到右排列。刘海面板宽度不变，小组件共享这个宽度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los widgets se disponen de izquierda a derecha en este orden. El panel de la muesca mantiene su ancho, así que los widgets lo comparten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets sont disposés de gauche à droite dans cet ordre. L'encoche conserve sa largeur, que les widgets se partagent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets werden in dieser Reihenfolge von links nach rechts angeordnet. Die Breite der Notch bleibt gleich, die Widgets teilen sie sich."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджеты располагаются слева направо в этом порядке. Ширина панели не меняется, виджеты делят её между собой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرتَّب العناصر من اليسار إلى اليمين بهذا الترتيب. يحتفظ النوتش بعرضه، فتتقاسمه العناصر."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os widgets são dispostos da esquerda para a direita nesta ordem. O notch mantém sua largura, então os widgets a dividem."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विजेट इसी क्रम में बाएँ से दाएँ लगते हैं। नॉच पैनल की चौड़ाई वही रहती है, इसलिए विजेट उसे साझा करते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットはこの順に左から右へ並びます。ノッチパネルの幅は変わらないため、その幅をウィジェットで分け合います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯은 이 순서대로 왼쪽에서 오른쪽으로 배치됩니다. 노치 패널의 너비는 그대로이므로 위젯이 나눠 씁니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I widget sono disposti da sinistra a destra in quest'ordine. Il notch mantiene la sua larghezza, che i widget si dividono."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget disusun dari kiri ke kanan dalam urutan ini. Lebar panel notch tetap, jadi widget berbagi lebar itu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các widget được xếp từ trái sang phải theo thứ tự này. Bảng notch giữ nguyên chiều rộng nên các widget chia nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดเจ็ตจะเรียงจากซ้ายไปขวาตามลำดับนี้ แผงโน้ตช์คงความกว้างเดิม วิดเจ็ตจึงแบ่งพื้นที่กัน"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakahanay ang mga widget mula kaliwa pakanan sa pagkakasunod-sunod na ito. Hindi nagbabago ang lapad ng notch panel, kaya pinaghahatian ito ng mga widget."
          }
        }
      }
    },
