    "settings.hapticFeedbackHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulses the trackpad for approvals, questions, and other notch events (Force Touch trackpads only)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在批准、问题和其他通知栏事件时使触控板震动（仅限支持 Force Touch 的触控板）。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace vibrar el trackpad en aprobaciones, preguntas y otros eventos del panel (solo trackpads Force Touch)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait vibrer le trackpad pour les approbations, questions et autres événements de l'encoche (trackpads Force Touch uniquement)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt das Trackpad bei Freigaben, Fragen und anderen Notch-Ereignissen vibrieren (nur Force-Touch-Trackpads)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активирует вибрацию трекпада при подтверждениях, вопросах и других событиях панели (только трекпады Force Touch)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يهتز لوحة التتبع عند الموافقات والأسئلة وأحداث أخرى (لوحات Force Touch فقط)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz o trackpad vibrar para aprovações, perguntas e outros eventos do notch (somente trackpads Force Touch)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमोदन, प्रश्नों और अन्य नॉच इवेंट के लिए ट्रैकपैड को स्पंदित करता है (केवल Force Touch ट्रैकपैड)।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認・質問・その他のノッチイベント時にトラックパッドを振動させます（Force Touch対応トラックパッドのみ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인, 질문 및 기타 노치 이벤트에 트랙패드를 진동시킵니다(Force Touch 트랙패드만 해당)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa vibrare il trackpad per approvazioni, domande e altri eventi del notch (solo trackpad Force Touch)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggetarkan trackpad untuk persetujuan, pertanyaan, dan peristiwa notch lainnya (hanya trackpad Force Touch)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm rung trackpad khi phê duyệt, câu hỏi và các sự kiện notch khác (chỉ trackpad hỗ trợ Force Touch)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สั่นแทร็กแพดสำหรับการอนุมัติ คำถาม และเหตุการณ์อื่น ๆ ของ notch (เฉพาะแทร็กแพดที่รองรับ Force Touch)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpapakurog ng trackpad para sa mga pag-apruba, tanong, at iba pang notch event (Force Touch trackpad lang)."
          }
        }
      }
    },
    "settings.integrationHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks let Claude and Codex send approvals, questions, and session status to the notch. Run this in a terminal to install or repair them:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钩子让 Claude 和 Codex 把批准、提问和会话状态发送到刘海。在终端运行以下命令来安装或修复："
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hooks permiten que Claude y Codex envíen aprobaciones, preguntas y estado de sesión a la muesca. Ejecuta esto en una terminal para instalarlos o repararlos:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hooks permettent à Claude et Codex d'envoyer approbations, questions et état de session à l'encoche. Exécutez ceci dans un terminal pour les installer ou les réparer :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks lassen Claude und Codex Freigaben, Fragen und Sitzungsstatus an die Notch senden. Führe dies im Terminal aus, um sie zu installieren oder zu reparieren:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки позволяют Claude и Codex отправлять подтверждения, вопросы и статус сессии в панель. Выполните это в терминале, чтобы установить или починить их:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتيح الخطافات لـ Claude وCodex إرسال الموافقات والأسئلة وحالة الجلسة إلى النوتش. نفّذ هذا في الطرفية للتثبيت أو الإصلاح:"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os hooks permitem que Claude e Codex enviem aprovações, perguntas e status de sessão ao notch. Execute isto em um terminal para instalar ou reparar:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हुक Claude और Codex को अनुमोदन, प्रश्न और सत्र स्थिति नॉच पर भेजने देते हैं। इंस्टॉल या ठीक करने के लिए टर्मिनल में यह चलाएँ:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hook を入れると、Claude と Codex から承認・質問・セッション状態がノッチに届きます。インストールまたは修復するには、ターミナルで次を実行してください:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훅을 설치하면 Claude와 Codex가 승인, 질문, 세션 상태를 노치로 보냅니다. 설치하거나 복구하려면 터미널에서 다음을 실행하세요:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli hook consentono a Claude e Codex di inviare approvazioni, domande e stato della sessione al notch. Esegui questo in un terminale per installarli o ripararli:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook memungkinkan Claude dan Codex mengirim persetujuan, pertanyaan, dan status sesi ke notch. Jalankan ini di terminal untuk memasang atau memperbaikinya:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook cho phép Claude và Codex gửi phê duyệt, câu hỏi và trạng thái phiên tới notch. Chạy lệnh này trong terminal để cài hoặc sửa:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฮุกทำให้ Claude และ Codex ส่งการอนุมัติ คำถาม และสถานะเซสชันไปยังโน้ตช์ รันคำสั่งนี้ในเทอร์มินัลเพื่อติดตั้งหรือซ่อมแซม:"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa pamamagitan ng hooks, naipapadala ng Claude at Codex ang mga pag-apruba, tanong, at status ng session sa notch. Patakbuhin ito sa terminal para i-install o ayusin:"
          }
        }
      }
    },
