    "settings.invertMediaSwipeHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default swiping left plays the next track."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认情况下，向左滑动播放下一首。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De forma predeterminada, deslizar a la izquierda reproduce la siguiente pista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, balayer vers la gauche lance la piste suivante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig spielt Wischen nach links den nächsten Titel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию смахивание влево включает следующий трек."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتراضيًا، السحب لليسار يشغّل المقطع التالي."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, deslizar para a esquerda toca a próxima faixa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट रूप से बाईं ओर स्वाइप करने पर अगला ट्रैक चलता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定では、左にスワイプすると次の曲を再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 왼쪽으로 쓸면 다음 트랙이 재생됩니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostazione predefinita, scorrere a sinistra riproduce il brano successivo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara bawaan, menggeser ke kiri memutar lagu berikutnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định, vuốt sang trái sẽ phát bài tiếp theo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าเริ่มต้น การปัดไปทางซ้ายจะเล่นเพลงถัดไป"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilang default, ang pag-swipe pakaliwa ay nagpapatugtog ng susunod na track."
          }
        }
      }
    },
    "settings.mediaKeysNeedAccessibility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Accessibility access to show a skip indicator when you press the media keys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许「辅助功能」权限，即可在按下媒体键时显示切歌提示。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso de Accesibilidad para mostrar un indicador al pulsar las teclas multimedia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès Accessibilité pour afficher un indicateur lors de l'appui sur les touches multimédias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen-Zugriff erlauben, um beim Drücken der Medientasten eine Anzeige einzublenden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к Универсальному доступу, чтобы видеть индикатор при нажатии медиаклавиш."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى تسهيلات الاستخدام لإظهار مؤشر عند الضغط على مفاتيح الوسائط."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso de Acessibilidade para exibir um indicador ao pressionar as teclas de mídia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया कुंजियाँ दबाने पर संकेतक दिखाने के लिए एक्सेसिबिलिटी एक्सेस दें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアキーを押したときにスキップ表示を出すには、アクセシビリティのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 키를 누를 때 건너뛰기 표시를 보려면 손쉬운 사용 접근 권한을 허용하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso ad Accessibilità per mostrare un indicatore quando premi i tasti multimediali."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses Aksesibilitas untuk menampilkan indikator saat menekan tombol media."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép quyền Trợ năng để hiện chỉ báo khi bạn nhấn phím media."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงตัวช่วยการเข้าถึงเพื่อแสดงตัวบ่งชี้เมื่อกดปุ่มสื่อ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang Accessibility access para magpakita ng skip indicator kapag pinindot ang media keys."
          }
        }
      }
    },
    "settings.mediaSwipe": {
      "localizations": {
        "en": {
