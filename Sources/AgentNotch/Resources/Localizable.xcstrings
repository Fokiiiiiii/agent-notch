          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser ke samping untuk ganti lagu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt ngang để đổi bài"
          }
        },
