    "notification.socketServerFailure.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local socket failed to start. Hook events from Claude/Codex won't reach the notch until AgentNotch is restarted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地套接字启动失败。在重启 AgentNotch 之前，来自 Claude/Codex 的 Hook 事件将无法到达灵动岛。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El socket local no pudo iniciarse. Los eventos de Claude/Codex no llegarán a la muesca hasta que reinicies AgentNotch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le socket local n'a pas pu démarrer. Les événements de Claude/Codex n'atteindront pas l'encoche tant qu'AgentNotch n'aura pas redémarré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Socket konnte nicht gestartet werden. Hook-Ereignisse von Claude/Codex erreichen den Notch erst nach einem Neustart von AgentNotch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить локальный сокет. События hook от Claude/Codex не будут доходить до панели, пока AgentNotch не перезапустится."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تشغيل المقبس المحلي. لن تصل أحداث الـ hook من Claude/Codex إلى الشق حتى إعادة تشغيل AgentNotch."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O socket local falhou ao iniciar. Os eventos de hook do Claude/Codex não chegarão ao notch até que o AgentNotch seja reiniciado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकल सॉकेट शुरू नहीं हो सका। जब तक AgentNotch पुनः आरंभ नहीं होता, Claude/Codex के हुक इवेंट नॉच तक नहीं पहुंचेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルソケットの起動に失敗しました。AgentNotchを再起動するまで、Claude/CodexからのフックイベントはノッチUIに届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 소켓을 시작하지 못했습니다. AgentNotch를 다시 시작할 때까지 Claude/Codex의 후크 이벤트가 노치에 도달하지 않습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il socket locale. Gli eventi hook di Claude/Codex non raggiungeranno il notch finché AgentNotch non verrà riavviato."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Socket lokal gagal dimulai. Peristiwa hook dari Claude/Codex tidak akan sampai ke notch hingga AgentNotch dimulai ulang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Socket cục bộ không khởi động được. Các sự kiện hook từ Claude/Codex sẽ không đến được notch cho đến khi khởi động lại AgentNotch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ็อกเก็ตภายในเครื่องเริ่มทำงานไม่สำเร็จ เหตุการณ์ hook จาก Claude/Codex จะไม่ไปถึงรอยบากจนกว่าจะรีสตาร์ท AgentNotch"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabigong magsimula ang lokal na socket. Hindi maaabot ng mga hook event mula sa Claude/Codex ang notch hangga't hindi nire-restart ang AgentNotch."
          }
        }
      }
    },
