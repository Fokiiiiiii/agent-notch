    "settings.shortcutsHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registered shortcuts appear in the Tray's ⋯ menu. Running one passes the selected Tray files to it as input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已注册的快捷指令会出现在托盘的 ⋯ 菜单中。运行时会把选中的托盘文件作为输入传入。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos registrados aparecen en el menú ⋯ de la bandeja. Al ejecutar uno se le pasan los archivos seleccionados como entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis enregistrés apparaissent dans le menu ⋯ du plateau. En exécuter un lui transmet les fichiers sélectionnés en entrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrierte Kurzbefehle erscheinen im ⋯-Menü des Trays. Beim Ausführen werden die ausgewählten Tray-Dateien als Eingabe übergeben."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавленные команды появляются в меню ⋯ лотка. При запуске выбранные файлы передаются команде на вход."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الاختصارات المسجَّلة في قائمة ⋯ بالدرج. عند تشغيل اختصار تُمرَّر إليه الملفات المحددة كمدخل."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos registrados aparecem no menu ⋯ da bandeja. Executar um passa os arquivos selecionados como entrada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंजीकृत शॉर्टकट ट्रे के ⋯ मेनू में दिखते हैं। चलाने पर चुनी गई ट्रे फ़ाइलें इनपुट के रूप में भेजी जाती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録したショートカットはトレイの ⋯ メニューに表示されます。実行すると、選択中のトレイのファイルが入力として渡されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록한 단축어는 트레이의 ⋯ 메뉴에 나타납니다. 실행하면 선택한 트레이 파일이 입력으로 전달됩니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I comandi rapidi registrati compaiono nel menu ⋯ del vassoio. Eseguendone uno, i file selezionati gli vengono passati come input."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan yang terdaftar muncul di menu ⋯ pada Tray. Menjalankannya akan mengirim berkas Tray yang dipilih sebagai masukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím tắt đã đăng ký xuất hiện trong menu ⋯ của Khay. Khi chạy, các tệp đang chọn được truyền vào làm đầu vào."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทางลัดที่ลงทะเบียนไว้จะอยู่ในเมนู ⋯ ของถาด เมื่อเรียกใช้ ไฟล์ที่เลือกในถาดจะถูกส่งเป็นอินพุต"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalabas ang mga nakarehistrong shortcut sa ⋯ menu ng Tray. Kapag pinatakbo, ipinapasa dito ang mga napiling file sa Tray bilang input."
          }
        }
      }
    },
