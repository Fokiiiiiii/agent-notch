    "settings.showWelcomeHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopens the gesture guide shown on first launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开首次启动时显示的手势指南。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir la guía de gestos que aparece al iniciar por primera vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvre le guide des gestes affiché au premier lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Gestenübersicht des ersten Starts erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова открывает руководство по жестам из первого запуска."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد فتح دليل الإيماءات الذي يظهر عند التشغيل الأول."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabre o guia de gestos exibido na primeira execução."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहली बार लॉन्च पर दिखाई गई जेस्चर गाइड फिर से खोलता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回起動時に表示される操作ガイドをもう一度開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 실행 시 표시되는 제스처 안내를 다시 엽니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapre la guida ai gesti mostrata al primo avvio."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka kembali panduan gestur yang muncul saat pertama dijalankan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở lại hướng dẫn cử chỉ hiển thị ở lần chạy đầu tiên."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดคู่มือท่าทางที่แสดงตอนเริ่มใช้ครั้งแรกอีกครั้ง"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Muling binubuksan ang gabay sa mga galaw na ipinapakita sa unang paglunsad."
          }
        }
      }
    },
