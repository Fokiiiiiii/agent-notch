    "settings.airPodsPrivateAPINote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS exposes no supported way to read this, so AgentNotch uses an undocumented one. It may stop reporting after a macOS update, in which case the indicator simply disappears."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 没有提供读取该信息的正式方式，因此 AgentNotch 使用了未公开的接口。macOS 更新后可能失效，届时该指示器会直接消失。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no ofrece una forma admitida de leer esto, así que AgentNotch usa una no documentada. Puede dejar de funcionar tras una actualización de macOS; en ese caso el indicador simplemente desaparece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'offre aucun moyen pris en charge de lire cette information ; AgentNotch en utilise donc un non documenté. Cela peut cesser de fonctionner après une mise à jour de macOS, auquel cas l'indicateur disparaît simplement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bietet keinen unterstützten Weg, das auszulesen, daher nutzt AgentNotch einen undokumentierten. Nach einem macOS-Update kann es ausfallen – dann verschwindet die Anzeige einfach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не предоставляет поддерживаемого способа это прочитать, поэтому AgentNotch использует недокументированный. После обновления macOS он может перестать работать — тогда индикатор просто исчезнет."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توفّر macOS طريقة مدعومة لقراءة ذلك، لذا يستخدم AgentNotch طريقة غير موثّقة. قد تتوقف بعد تحديث macOS، وحينها يختفي المؤشر ببساطة."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não oferece uma forma suportada de ler isso, então o AgentNotch usa uma não documentada. Pode parar de funcionar após uma atualização do macOS; nesse caso o indicador simplesmente desaparece."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS इसे पढ़ने का कोई समर्थित तरीका नहीं देता, इसलिए AgentNotch एक अनौपचारिक तरीका इस्तेमाल करता है। macOS अपडेट के बाद यह बंद हो सकता है, तब यह संकेतक बस गायब हो जाएगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS にはこれを読むための正式な手段が無いため、AgentNotch は非公開の手段を使っています。macOS のアップデートで動かなくなる可能性があり、その場合この表示は単に出なくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에는 이를 읽는 공식적인 방법이 없어 AgentNotch는 비공개 방식을 사용합니다. macOS 업데이트 후 동작하지 않을 수 있으며, 그 경우 표시가 그냥 사라집니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non offre un modo supportato per leggerlo, quindi AgentNotch ne usa uno non documentato. Potrebbe smettere di funzionare dopo un aggiornamento di macOS: in tal caso l'indicatore semplicemente scompare."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS tidak menyediakan cara resmi untuk membacanya, jadi AgentNotch memakai cara tak terdokumentasi. Bisa berhenti bekerja setelah pembaruan macOS; indikatornya akan hilang begitu saja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS không có cách chính thức để đọc thông tin này nên AgentNotch dùng cách không được ghi nhận. Nó có thể ngừng hoạt động sau khi cập nhật macOS, khi đó chỉ báo sẽ biến mất."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ไม่มีวิธีที่รองรับให้อ่านค่านี้ AgentNotch จึงใช้วิธีที่ไม่ได้เปิดเผย อาจหยุดทำงานหลังอัปเดต macOS ซึ่งตัวบ่งชี้จะหายไปเฉย ๆ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang suportadong paraan ang macOS para basahin ito, kaya gumagamit ang AgentNotch ng hindi opisyal. Maaari itong tumigil pagkatapos ng update ng macOS — mawawala na lang ang indicator."
          }
        }
      }
    },
