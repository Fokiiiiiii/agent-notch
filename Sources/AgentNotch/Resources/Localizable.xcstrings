    "agents.sessionAccessibilityHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to select. Use the actions rotor to jump to Terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击以选择。使用操作转轮跳转到终端。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para seleccionar. Usa el rotor de acciones para ir a Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez deux fois pour sélectionner. Utilisez le rotor d'actions pour aller au Terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelt tippen zum Auswählen. Verwende das Aktionsrad, um zum Terminal zu springen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды нажмите, чтобы выбрать. Используйте ротор действий, чтобы перейти в Terminal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر مرتين للتحديد. استخدم عجلة الإجراءات للانتقال إلى Terminal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para selecionar. Use o rotor de ações para ir ao Terminal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयन के लिए डबल-टैप करें। Terminal पर जाने के लिए एक्शन रोटर का उपयोग करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップで選択します。アクションローターからTerminalへジャンプできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭하여 선택하세요. 작업 로터를 사용해 Terminal로 이동할 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per selezionare. Usa la rotella delle azioni per andare al Terminal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali untuk memilih. Gunakan rotor tindakan untuk membuka Terminal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm đúp để chọn. Dùng bánh xe hành động để chuyển đến Terminal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะสองครั้งเพื่อเลือก ใช้ Actions Rotor เพื่อไปที่ Terminal"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-double-tap para pumili. Gamitin ang actions rotor para tumalon sa Terminal."
          }
        }
      }
    },
